#!/bin/sh
# Runs darwin from the release bundle shipped with OMA. Its launcher picks the
# binary for this platform, raises the stack limit and loads the bundled
# darwin library.

DARWIN_LAUNCHER="$(dirname "$0")/../darwin/bin/darwin"

if [ -x "$DARWIN_LAUNCHER" ]; then
    exec "$DARWIN_LAUNCHER" "$@"
else
    # e.g. running from a git checkout: use the darwin found on the PATH
    exec darwin "$@"
fi
